{
  "name": "n8n-nodes-postman",
  "version": "0.1.1",
  "description": "n8n community node for the Postman API",
  "license": "MIT",
  "homepage": "https://github.com/hansdoebel/n8n-nodes-postman#readme",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "postman",
    "api",
    "api-testing",
    "api-management",
    "collections",
    "workflows",
    "automation"
  ],
  "author": {
    "name": "Hans Doebel",
    "email": "hansdev@mailbox.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hansdoebel/n8n-nodes-postman.git"
  },
  "bugs": {
    "url": "https://github.com/hansdoebel/n8n-nodes-postman/issues"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "bun test"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/PostmanApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Postman/Postman.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "bun-types": "^1.3.9",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
